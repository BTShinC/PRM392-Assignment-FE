<?xml version="1.0" encoding="utf-8"?>
<!-- File: res/drawable/overlay_gradient_notification.xml -->
<!-- Overlay gradient nhẹ cho hình ảnh món ăn - tạo hiệu ứng tinh tế -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient từ trong suốt sang cam nhạt -->
    <gradient
        android:angle="135"
        android:startColor="#00000000"
        android:endColor="#20FF6B35"
        android:type="linear" />

    <!-- Bo góc khớp với ImageView -->
    <corners android:radius="12dp" />

</shape>