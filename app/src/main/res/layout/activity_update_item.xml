<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.admin.UpdateItemActivity">

    <ImageView
        android:id="@+id/iv_item_image_update"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btn_change_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đổi ảnh"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/et_item_name_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên món ăn"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_item_description_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Mô tả"
        android:inputType="textMultiLine" />

    <EditText
        android:id="@+id/et_item_price_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Giá"
        android:inputType="numberDecimal" />

    <Spinner
        android:id="@+id/spinner_category_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_is_available_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Có sẵn"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_save_item_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Lưu thay đổi" />

</LinearLayout>
